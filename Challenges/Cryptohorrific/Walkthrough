CCCryptorStatus
CCCrypt(CCOperation op, CCAlgorithm alg, CCOptions options,
    const void *key, size_t keyLength, const void *iv,
    const void *dataIn, size_t dataInLength, void *dataOut,
    size_t dataOutAvailable, size_t *dataOutMoved);


Position	Arg	Value	Meaning
1	op	op (variable)	encrypt or decrypt — check what's passed in as op; likely 0 = encrypt, 1 = decrypt
2	alg	0	kCCAlgorithmAES (AES, also AES128 — algorithm 0 is AES)
3	options	3	flags — this is a bitmask. kCCOptionPKCS7Padding = 0x0001, kCCOptionECBMode = 0x0002. 3 = both bits set → PKCS7 padding + ECB mode
4	key	local_38	pointer to key bytes
5	keyLength	0x10	16 bytes → AES-128 key
6	iv	local_58	IV pointer — note: irrelevant in ECB mode since ECB doesn't use an IV, so this is likely ignored by CommonCrypto even though it's passed
7	dataIn	dataIn	input buffer
8	dataInLength	local_98	input length
9	dataOut	local_a8	output buffer
10	dataOutAvailable	local_a0	output buffer capacity
11	dataOutMoved	&local_b0	out-param: bytes actually written


